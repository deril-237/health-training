// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum WaveStatus {
  PENDING 
  FINISHED
  OPEN
}


enum InscriptionStatus {
  // DRAFT
  // EMAIL_PENDING
  SUBMITTED
  ACCEPTED
  REJECTED 

}

enum ModalityOption {
  ON_LINE
  OFF_LINE
}


enum StorageProvider {
  CLOUDINARY
}


model Program {
  id String @id @default(cuid())
  duration Int @unique
  trainingPrograms TrainingProgram[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("programs")
}


model Training {
  id String @id @default(cuid())
  name String @unique 
  description String 
  objective  String
  image String? 
  price Float
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  trainingPrograms TrainingProgram[]
  @@map("trainings")
}

model TrainingProgram {
  id String @id @default(cuid())
  trainingId String @map("training_id")
  programId String @map("program_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  program Program @relation(fields: [programId], references: [id])
  training Training @relation(fields: [trainingId], references: [id])

  waves Wave[]
  modules Module[]

  @@unique([trainingId,programId])
  @@map("training_program")
}


model Module {
  id String @id @default(cuid())
  name String
  position Int
  description String 
  file String?  
  trainingProgramId String @map("training_program_id")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")


  trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id]) 
  @@unique([trainingProgramId, position]) 

  @@map("modules")
}

model Wave {
  id String  @id @default(cuid())
  startDate DateTime @db.Date @map("start_date") // unique formationProgram
  quota Int 
  status WaveStatus
  price Decimal @db.Decimal(10,2)
  // numberWave Int @map("number_wave")
  trainingProgramId String @map("training_program_id")

  inscriptions Inscription[]
  trainingProgram TrainingProgram @relation(fields: [trainingProgramId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("waves")
}

model Student {
  id String @id @default(cuid())
  numCNIPassport String @map("num_cni_passport")
  name String
  secondName String @map("second_name")
  birthDate DateTime @db.Date @map("birth_date")
  birthPlace String  @map("birth_place")
  residence String 
  email String
  diplomaUrl String @map("diploma_url")
  cniPhotoUrl String @map("cni_photo_url")
  photoUrl String @map("photo_url")
  motivations StudentMotivation[]
  inscriptions Inscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  
  @@map("students")
}

model OptionMotivation {
  id String @id @default(cuid())
  label String
  order Int
  

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  student StudentMotivation[]
}

model StudentMotivation {
  id String @id @default(cuid())
  studentId String 
  optionId String?
  textResponse String?

  student Student @relation(fields: [studentId], references: [id])
  option OptionMotivation? @relation(fields: [optionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, optionId])
  @@map("student_motivations")
}

model Inscription {
  id String @id @default(cuid())
  studentId String 
  waveId String
  status InscriptionStatus
  modality ModalityOption
  reasonRejected String?

  student Student @relation(fields: [studentId], references: [id])
  wave Wave @relation(fields: [waveId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, waveId])
  @@map("inscriptions")
}


model FileAsset {

  id String @id @default(cuid())
  provider StorageProvider
  key String @unique
  url String
  originalName String
  mimeType String
  size Int
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}